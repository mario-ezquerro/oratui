[Unit]
Description=ORA-TUI OpenTelemetry & Prometheus Exporter Daemon for Oracle RAC / Single Instance & Linux SAN
Documentation=https://github.com/mario-ezquerro/oratui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment="ORA_TUI_PORT=9161"
Environment="ORA_TUI_INTERVAL=15s"
ExecStart=/bin/sh -c 'exec /usr/bin/ora-tui --opentelemetry --daemon --otel-port=${ORA_TUI_PORT} --interval=${ORA_TUI_INTERVAL}'
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
